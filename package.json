{
  "name": "medforge-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:ui-review": "node scripts/capture_ui_review.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "contracts:generate": "python3 scripts/export_openapi.py && openapi-typescript contracts/openapi-implemented.json -o packages/contracts/generated-api.ts",
    "contracts:check": "python3 scripts/export_openapi.py && openapi-typescript contracts/openapi-implemented.json --check -o packages/contracts/generated-api.ts",
    "doctor": "python3 scripts/doctor.py",
    "audit:endoscapes-cvs": "python3 scripts/audit_endoscapes_cvs_coverage.py",
    "smoke:local": "python3 scripts/smoke_local.py",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@cornerstonejs/core": "5.11.7",
    "@cornerstonejs/tools": "5.11.7",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "events": "3.3.0",
    "lucide-react": "1.53.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
