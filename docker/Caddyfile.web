# Static file server for the built app (private network only).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode gzip
	# Hashed build assets can be cached; the app shell must revalidate.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
