# Single public entry point. TLS 1.3 only, with a certificate from Caddy's local CA
# (export it with scripts/check-tls.mjs to trust it). Routes /api, /healthz and the API docs
# to the API, everything else to the web app.
{
	admin off
	skip_install_trust
	auto_https disable_redirects
}

(app) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@api path /api/* /healthz /docs /openapi.json
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:8080
	}
}

https://localhost, https://127.0.0.1 {
	tls internal {
		protocols tls1.3
	}
	import app
}

http://localhost, http://127.0.0.1 {
	redir https://{host}:{$MEDFORGE_HTTPS_PORT:8443}{uri} permanent
}
